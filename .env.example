# ==============================================================================
# AMRITA ATTENDANCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit production credentials, secret keys, or live passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Profile
# ------------------------------------------------------------------------------
PROJECT_NAME="Amrita BLE Attendance Platform"
VERSION=1.0.0
ENVIRONMENT=development
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. Relational Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-database-password@localhost:5432/attendance_db
SYNC_DATABASE_URL=postgresql://postgres:replace-with-database-password@localhost:5432/attendance_db

# ------------------------------------------------------------------------------
# 3. Security, Encryption & Cryptographic Secrets
# ------------------------------------------------------------------------------
# High-entropy random secret key (minimum 32 characters / 256 bits)
# Generated via: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-value
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
MAX_CSV_UPLOAD_SIZE_BYTES=2097152

# ------------------------------------------------------------------------------
# 4. Firebase Project Settings (Client & Admin SDK)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=attendance-ble-app-6b0e3
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# ------------------------------------------------------------------------------
# 5. Institutional Domain Validation
# ------------------------------------------------------------------------------
INSTITUTIONAL_STUDENT_DOMAIN=amrita.edu
INSTITUTIONAL_FACULTY_DOMAIN=cb.amrita.edu

# ------------------------------------------------------------------------------
# 6. BLE Protocol Parameters
# ------------------------------------------------------------------------------
BLE_NAMESPACE_HEX=414d5254424c450000000000
BLE_ROTATION_INTERVAL_SECONDS=20
BLE_RSSI_CHECKIN_THRESHOLD_DBM=-80

# ------------------------------------------------------------------------------
# 7. AI Agent & External Service Integrations (Optional)
# ------------------------------------------------------------------------------
HUGGINGFACE_API_TOKEN=""
HUGGINGFACE_MODEL_ID=priyanrajj/attendanceagent
HUGGINGFACE_BUCKET_ID=priyanrajj/attendanceagent-bucket
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models/priyanrajj/attendanceagent
