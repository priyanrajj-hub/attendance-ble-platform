# ==============================================================================
# AMRITA ATTENDANCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# DO NOT commit real secrets or production .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Project Settings (Client & Emulator)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=attendance-ble-app-6b0e3
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# ------------------------------------------------------------------------------
# 2. Institutional Domain Validation
# ------------------------------------------------------------------------------
INSTITUTIONAL_STUDENT_DOMAIN=amrita.edu
INSTITUTIONAL_FACULTY_DOMAIN=cb.amrita.edu

# ------------------------------------------------------------------------------
# 3. BLE Protocol Parameters
# ------------------------------------------------------------------------------
BLE_NAMESPACE_HEX=414d5254424c450000000000
BLE_ROTATION_INTERVAL_SECONDS=20
BLE_RSSI_CHECKIN_THRESHOLD_DBM=-80

# ------------------------------------------------------------------------------
# 4. Backend Microservice (FastAPI - Optional / Management)
# ------------------------------------------------------------------------------
PROJECT_NAME="Amrita BLE Attendance API"
VERSION=1.0.0
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/attendance_db
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/attendance_db

# ------------------------------------------------------------------------------
# 5. Security & AI Extensions
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
HUGGINGFACE_API_TOKEN=your_huggingface_token_here
HUGGINGFACE_MODEL_ID=priyanrajj/attendanceagent
