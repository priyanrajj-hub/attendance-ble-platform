# ==========================================
# Attendance BLE Platform - Environment Config
# Copy this file to .env and configure values
# ==========================================

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database (PostgreSQL RDS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/attendance_db

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=attendance-ble-placeholder
FIREBASE_CREDENTIALS_PATH=./firebase-admin.json

# AI Assistant (Anthropic Claude API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Configurable model ID (e.g., claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022)
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS_PER_DAY=100000

# AWS Infrastructure (S3 & KMS)
AWS_REGION=ap-south-1
AWS_S3_BUCKET_EXPORTS=attendance-exports-dev
