rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function emailOk()  { return request.auth != null && request.auth.token.email_verified == true; }
    function me()       { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isRole(r)  { return emailOk() && me().role == r && me().status == 'verified'; }
    function isAdmin()   { return isRole('admin'); }
    function isFaculty() { return isRole('faculty'); }
    function isStudent() { return isRole('student'); }
    function sess(id)    { return get(/databases/$(database)/documents/sessions/$(id)).data; }
    function ownsSession(id) { return isFaculty() && sess(id).facultyId == request.auth.uid; }
    function enrolled(courseId, uid) {
      return exists(/databases/$(database)/documents/enrollments/$(courseId + '_' + uid));
    }

    match /users/{uid} {
      allow get:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','role','status','rollNo','createdAt'])
        && request.resource.data.keys().hasAll(['name','email','role','status','createdAt'])
        && request.resource.data.status == 'pending_verification'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time
        && ((request.resource.data.role == 'student'
              && request.auth.token.email.matches('^[a-zA-Z0-9._-]+@ch\\.students\\.amrita\\.edu$'))
         || (request.resource.data.role == 'faculty'
              && request.auth.token.email.matches('^[a-zA-Z0-9._-]+@ch\\.amrita\\.edu$')));
      // self-service: name, and deviceId exactly once
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','deviceId'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deviceId'])
            || !('deviceId' in resource.data));
      // admin: every admin write must stamp verifiedBy/verifiedAt
      allow update: if isAdmin() && uid != request.auth.uid && resource.data.role != 'admin'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','verifiedBy','verifiedAt','rejectionReason','deviceId'])
        && request.resource.data.status in ['pending_verification','verified','rejected','suspended']
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.verifiedAt == request.time;
    }

    match /courses/{courseId} {
      allow read: if isAdmin()
        || (isFaculty() && request.auth.uid in resource.data.facultyIds)
        || (isStudent() && enrolled(courseId, request.auth.uid));
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['code','title','room','facultyIds']);
      allow delete: if isAdmin();
    }

    match /enrollments/{eid} {
      allow read: if isAdmin()
        || (isStudent() && resource.data.studentUid == request.auth.uid)
        || (isFaculty() && request.auth.uid in
              get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.facultyIds);
      allow create, update: if isAdmin()
        && eid == request.resource.data.courseId + '_' + request.resource.data.studentUid
        && request.resource.data.keys().hasOnly(['courseId','studentUid','studentName','rollNo','enrolledAt']);
      allow delete: if isAdmin();
    }

    match /sessions/{sid} {
      // no secrets live here
      allow read: if emailOk();
      allow create: if isFaculty()
        && request.resource.data.keys().hasOnly(['courseId','facultyId','startedAt','endsAt','status','backendSessionId'])
        && request.resource.data.facultyId == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.facultyIds
        && request.resource.data.status == 'open'
        && request.resource.data.startedAt == request.time
        && request.resource.data.endsAt > request.time
        && request.resource.data.endsAt <= request.time + duration.value(30, 'm')
        && (!('backendSessionId' in request.resource.data) || request.resource.data.backendSessionId is string);
      allow update: if ownsSession(sid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endsAt','backendSessionId'])
        && request.resource.data.status in ['open','closed']
        && request.resource.data.endsAt <= resource.data.startedAt + duration.value(30, 'm');

      match /live/current {
        allow read: if ownsSession(sid);
        allow create, update: if ownsSession(sid)
          && request.resource.data.keys().hasOnly(['code','prevCode','rotatedAt'])
          && request.resource.data.code is string && request.resource.data.code.size() in [8, 32]
          && (!('prevCode' in request.resource.data) || (request.resource.data.prevCode is string && request.resource.data.prevCode.size() in [8, 32]))
          && request.resource.data.rotatedAt == request.time;
      }

      match /attendance/{uid} {
        allow read: if isAdmin() || ownsSession(sid) || (isStudent() && request.auth.uid == uid);
        // Direct client SDK writes are strictly disabled.
        // PostgreSQL via FastAPI is the sole authoritative check-in ledger.
        // Projections are written exclusively by the backend service via the Firebase Admin SDK.
        allow write: if false;
      }
    }

    // student attendance history (collection-group query filtered on studentUid)
    match /{path=**}/attendance/{uid} {
      allow read: if isStudent() && resource.data.studentUid == request.auth.uid;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
