rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reads directly from the Database instead of using Cloud Function Custom Claims
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users collection ──────────────────────────────────────────
    match /users/{userId} {
      
      // Allow users to read their own doc REGARDLESS of email_verified 
      // so the UI can source their name/role and show "Please verify email". 
      // Allow Faculty and Admins full access to render rosters.
      allow read: if request.auth != null &&
                     (
                       request.auth.uid == userId || 
                       isAdmin() || 
                       (request.auth.token.email_verified == true && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty' && resource.data.role == 'student')
                     );

      allow create: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['name', 'rollNo', 'role', 'email', 'parentEmail', 'photoUrl', 'status', 'createdAt']) &&
          request.resource.data.status == 'verified' &&
          request.resource.data.email == request.auth.token.email &&
          (
            (request.resource.data.role == 'student' &&
             request.auth.token.email.matches('^[a-zA-Z0-9._-]+@ch\\.students\\.amrita\\.edu$'))
            ||
            (request.resource.data.role == 'faculty' &&
             request.auth.token.email.matches('^[a-zA-Z0-9._-]+@ch\\.amrita\\.edu$'))
          );

      // Block users from modifying role/status. 
      allow update: if request.auth != null && request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role']);

      // Admins can update any user document (approve/reject, set role).
      allow update: if request.auth != null && isAdmin();
    }

    // ── Sessions collection ───────────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      
      allow create: if request.auth != null && request.auth.token.email_verified == true &&
                       (
                         (request.resource.data.facultyId == request.auth.uid && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty')
                         || isAdmin()
                       );
                       
      allow update: if request.auth != null && request.auth.token.email_verified == true &&
                       (
                         (resource.data.facultyId == request.auth.uid &&
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['facultyId']))
                         || isAdmin()
                       );
      
      // Private subcollection containing details (hmacSecret) - only faculty owner or admin can read/write.
      match /private/details {
        allow read: if request.auth != null && request.auth.token.email_verified == true &&
                      (resource.data.facultyId == request.auth.uid || isAdmin());
        allow write: if request.auth != null && request.auth.token.email_verified == true &&
                       ((resource == null && request.resource.data.facultyId == request.auth.uid) ||
                        (resource != null && resource.data.facultyId == request.auth.uid) || isAdmin());
      }

      // Attendance subcollection - no client writes, all updates must go through markAttendance... 
      // WAIT: we abandoned cloud functions! Client MUST be able to mark attendance.
      match /attendance/{studentId} {
        allow read: if request.auth != null && request.auth.token.email_verified == true &&
                      (request.auth.uid == studentId ||
                       get(/databases/$(database)/documents/sessions/$(sessionId)).data.facultyId == request.auth.uid ||
                       isAdmin());
        // Students CANNOT write. The BLE architecture relies on the Faculty Scanner app pushing the attendance document.
        allow write: if request.auth != null && request.auth.token.email_verified == true && 
                      (get(/databases/$(database)/documents/sessions/$(sessionId)).data.facultyId == request.auth.uid || isAdmin());
      }

      match /audit/{auditId} {
        allow read: if request.auth != null && request.auth.token.email_verified == true && isAdmin();
        allow write: if false;
      }
    }

    // ── Notifications collection ──────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.token.email_verified == true &&
                     resource.data.studentUid == request.auth.uid;
      allow create: if request.auth != null && request.auth.token.email_verified == true &&
                       request.resource.data.studentUid == request.auth.uid &&
                       !request.resource.data.keys().hasAny(['recipients', 'body', 'subject', 'status']);
    }

    // ── Default deny ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

