# PostgreSQL Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/attendance_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendance_db

# Firebase Configuration
FIREBASE_PROJECT_ID=attendance-ble-test
# Optional path to local service account json (leave empty to use default ADC/mock)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["*"]
