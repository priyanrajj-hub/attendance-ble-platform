# ==============================================================================
# BACKEND MICROSERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' inside the backend/ directory or repository root.
# ==============================================================================

PROJECT_NAME="BLE Attendance Platform API"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/attendance_db"
SYNC_DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/attendance_db"

# Firebase Project
FIREBASE_PROJECT_ID="attendance-ble-app-6b0e3"
FIREBASE_SERVICE_ACCOUNT_PATH=""

# Security & CORS
CORS_ORIGINS=["*"]
MAX_CSV_UPLOAD_SIZE_BYTES=2097152

# Hugging Face AI Agent Integration
HUGGINGFACE_API_TOKEN=""
HUGGINGFACE_MODEL_ID="priyanrajj/attendanceagent"
HUGGINGFACE_BUCKET_ID="priyanrajj/attendanceagent-bucket"
HUGGINGFACE_API_URL="https://api-inference.huggingface.co/models/priyanrajj/attendanceagent"
