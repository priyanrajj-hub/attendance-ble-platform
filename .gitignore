# ==============================================================================
# AMRITA ATTENDANCE PLATFORM - MASTER GITIGNORE CONFIGURATION
# Hardened DevSecOps Specification for Multi-Tier Mobile & Backend Architecture
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Configuration Files (Secrets Protection)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development
.env.production
.env.test
.env.staging
.env.backup
.env.bak
env/.env*
backend/env/.env*

# Explicit preservation of template examples
!.env.example
!**/.env.example

# ------------------------------------------------------------------------------
# 2. Python & FastAPI Backend
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
!env/.env.example
!backend/env/.env.example

# Testing, typing, and linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
nosetests.xml

# ------------------------------------------------------------------------------
# 3. Flutter & Dart
# ------------------------------------------------------------------------------
.dart_tool/
.packages
.pub/
.pub-cache/
coverage/
.flutter-plugins
.flutter-plugins-dependencies
*.lock.tmp
**/GeneratedPluginRegistrant.*

# Always preserve dependency lockfile for reproducible builds
!pubspec.lock

